{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ES2020",
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "noEmitOnError": true,
    "outDir": "dist/esm",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "declarationMap": true,
    "skipLibCheck": true
  },
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "include": [
    "src"
  ]
}
